<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/citySelectorContainer" android:layout_width="wrap_content" android:layout_height="48dp"
    android:layout_gravity="end|center_vertical"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground" android:paddingStart="8dp" android:paddingEnd="4dp">
    <Spinner android:id="@+id/citySelector" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:padding="0dp" android:background="@null" android:contentDescription="Selected city" android:spinnerMode="dropdown"/>
    <TextView android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center"
        android:text="▾" android:textSize="18sp" android:importantForAccessibility="no"/>
</LinearLayout>
