<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/weatherlens_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
            <TextView style="@style/Lens.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A NEW PERSPECTIVE" android:letterSpacing="0.12"/>
            <TextView style="@style/Lens.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find your sky" android:layout_marginTop="16dp"/>
            <TextView style="@style/Lens.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A familiar place or your next adventure." android:layout_marginTop="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:tag="lens_card" android:background="@drawable/lens_card" android:padding="22dp" android:layout_marginTop="16dp">
                <ImageView android:layout_width="100dp" android:layout_height="100dp" android:layout_gravity="center_horizontal" android:src="@drawable/lens_mascot" android:importantForAccessibility="no"/>
                <TextView style="@style/Lens.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Where are we heading?"/>
                <com.google.android.material.textfield.TextInputLayout style="@style/Lens.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="City name" android:layout_marginTop="20dp">
                    <com.google.android.material.textfield.TextInputEditText style="@style/Lens.EditText" android:id="@+id/editTextCityName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/buttonSaveCity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Save city"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/buttonCancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Cancel" android:tag="secondary" app:backgroundTint="#FFFFFF"/>
</LinearLayout>
